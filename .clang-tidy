---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  clang-analyzer-*,
  performance-*,
  -performance-enum-size,
  -performance-avoid-endl,
  modernize-use-override,
  modernize-use-nullptr

WarningsAsErrors: ''

# Lint project code under src/* except vendored CLI11, nlohmann/json, and libsodium.
HeaderFilterRegex: '^.*/src/(?:lib/(?!(?:cli|json)/include(?:/|$)|sodium(?:/|$)|http(?:/|$))|consensus|ledger|network|chain|server|client|app)/.*'

FormatStyle: none
